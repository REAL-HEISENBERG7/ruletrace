# ==============================================================================
# RuleTrace AI — Environment Configuration Template
# Smart India Hackathon 2026 | Team UNCUT GEMS | SIH26261
# ==============================================================================
# Copy this file to .env in backend/ or root to configure your local setup.
# In development, default values work out-of-the-box with SQLite and local ports.

# ------------------------------------------------------------------------------
# Backend Configuration (backend/.env)
# ------------------------------------------------------------------------------

# Database Connection
# SQLite (default for development/demo):
DATABASE_URL=sqlite:///./ruletrace.db
# PostgreSQL (production):
# DATABASE_URL=postgresql://ruletrace_user:secure_password@localhost:5432/ruletrace_db

# Security & JWT Authentication
# IMPORTANT: Generate a strong secret key in production (e.g., openssl rand -hex 32)
SECRET_KEY=change-this-in-production-to-a-secure-random-secret-key-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# File Upload Storage
UPLOAD_DIR=./uploads/documents
MAX_FILE_SIZE_MB=20

# OCR Engine (Tesseract)
# On Windows: C:\Program Files\Tesseract-OCR\tesseract.exe
# On Linux/macOS: tesseract
TESSERACT_CMD=tesseract

# CORS Configuration (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Demonstration Mode (enables synthetic scenario seeding on startup)
DEMO_MODE=true

# ------------------------------------------------------------------------------
# Frontend Configuration (frontend/.env.local)
# ------------------------------------------------------------------------------

# FastAPI Backend Endpoint
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
