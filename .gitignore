# RuleTrace AI — .gitignore
# Smart India Hackathon 2026 | Team UNCUT GEMS | SIH26261

# Node.js / Frontend dependencies & builds
node_modules/
.next/
out/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
frontend/.next/
frontend/out/
frontend/build/
frontend/node_modules/

# Python / Backend caches & environments
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# Databases & Runtime Uploads
*.db
*.sqlite
*.sqlite3
backend/ruletrace.db
backend/uploads/documents/*
!backend/uploads/documents/.gitkeep
backend/uploads/temp/*
!backend/uploads/temp/.gitkeep

# Environment variables & secrets (keep example files)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
frontend/.env
frontend/.env.local
backend/.env
!.env.example
!frontend/.env.example
!backend/.env.example

# IDE & OS specific files
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
Thumbs.db
Desktop.ini
*.log
