# RuleTrace AI — Environment Configuration
# Copy this file to .env and update the values before running.

# ── Database ─────────────────────────────────────────────────────────────────
# PostgreSQL connection URL. For local dev you may also use SQLite (see README).
DATABASE_URL=postgresql://ruletrace:ruletrace_pass@localhost:5432/ruletrace_db

# SQLite alternative for development without PostgreSQL:
# DATABASE_URL=sqlite:///./ruletrace.db

# ── Security ──────────────────────────────────────────────────────────────────
# CHANGE THIS before deploying anywhere. Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-long-random-string-before-any-deployment
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── File Storage ─────────────────────────────────────────────────────────────
UPLOAD_DIR=./uploads/documents
MAX_FILE_SIZE_MB=20

# ── OCR / Document Processing ─────────────────────────────────────────────────
# Path to Tesseract executable (required for image OCR).
# Windows example: C:\Program Files\Tesseract-OCR\tesseract.exe
# Linux/macOS: tesseract (if on PATH)
TESSERACT_CMD=tesseract

# ── CORS ─────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Optional AI (disabled by default) ────────────────────────────────────────
# Uncomment and set these only if you want to enable optional LLM assistance.
# OPENAI_API_KEY=
# AI_PROVIDER=openai

# ── Demo Mode ────────────────────────────────────────────────────────────────
# When true, seeded demo data and credentials are available.
DEMO_MODE=true

# ── Email Notifications (optional) ──────────────────────────────────────────
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# EMAILS_FROM=ruletrace@example.com
